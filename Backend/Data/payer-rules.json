  {
    "id": "rule-001",
    "payerName": "Medicare",
    "version": "1.0",
    "effectiveDate": "2024-01-01",
    "isActive": true,
    "requirements": [
      {
        "name": "Medical License",
        "type": "Document",
        "mandatory": true,
        "expirationThresholdDays": 30,
        "validationRules": ["Must be current and valid", "State-issued"]
      },
      {
        "name": "DEA Certificate",
        "type": "Document",
        "mandatory": true,
        "expirationThresholdDays": 30,
        "validationRules": ["Federal DEA registration", "Must match provider name"]
      },
      {
        "name": "Malpractice Insurance",
        "type": "Document",
        "mandatory": true,
        "expirationThresholdDays": 30,
        "validationRules": ["Minimum coverage $1M/$3M", "Current certificate"]
      },
      {
        "name": "NPI Number",
        "type": "Data",
        "mandatory": true,
        "validationRules": ["Valid 10-digit NPI", "Type 1 (Individual)"]
      }
    ]
  },
